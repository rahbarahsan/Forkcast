    "dotenv": "^16.5.0",
    "expo": "~58.0.14",
    "expo-asset": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "react": "19.3.0",
