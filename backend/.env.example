# Optional. No configuration or credentials are needed for local operation.
# Set environment variables in your shell when overriding these defaults.
# FORKCAST_DATABASE=/absolute/path/to/forkcast.sqlite3
# FORKCAST_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081
# Optional model access. These settings override the in-app model selector.
# FORKCAST_MODEL_PROVIDER=codex
# FORKCAST_MODEL=
# API modes: openai, anthropic, google. Set the matching server-only key.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# Optional typed decision review:
# FORKCAST_DECISION_PROVIDER=jev
# FORKCAST_DECISION_MODEL=jev-latest
# TYPESAFE_API_KEY=
