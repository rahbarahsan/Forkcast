# Node modules - ignore in any directory
**/node_modules/
.buckd/
.bazel/
.pnp/
.pnp.js

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.yarnrc.yml

# Expo
.expo/
.expo-shared/

# TypeScript
*.tsbuildinfo

# macOS
.DS_Store

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE
.vscode/
.idea/

# Testing
coverage/

# Environment files - ignore in any directory
**/.env
**/.env.*
# ...but the templates must be committed so others can set the project up.
!**/.env.example

# Retired local pipeline output
/backend/ingredient_pipeline/

# Python
# Ignore __pycache__ in any directory
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
*.egg-info/
.installed.cfg
*.egg
# Virtualenvs under any name (venv_admin/, .venv-3.11/, ...)
**/venv*/
**/.venv*/

# Retired local corpora
**/nltk_data/

# Build artifacts
dist/
build/
web-build/

# Metro
metro-cache/

# Python tooling
.pytest_cache/
.ruff_cache/

